#!/usr/bin/env bash
# Fake gh: serves fixtures from $FX, logs every call to $FX/calls.log.
printf '%s\n' "$*" >> "$FX/calls.log"
[[ "$1" == api ]] || { echo "fake gh: unsupported $*" >&2; exit 2; }
shift
jqexpr="" endpoint=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --jq) jqexpr="$2"; shift 2 ;;
    --paginate) shift ;;
    -f|-F) shift 2 ;;
    graphql) endpoint=graphql; shift ;;
    *) [[ -z "$endpoint" ]] && endpoint="$1"; shift ;;
  esac
done
case "$endpoint" in
  graphql) f="$FX/graphql.json" ;;
  */reviews) f="$FX/reviews.json" ;;
  */reactions) [[ -n "${FAIL_REACTION:-}" && "$endpoint" == *"/$FAIL_REACTION/"* ]] && exit 1; echo '{}'; exit 0 ;;
  repos/*/pulls/[0-9]*) f="$FX/pr.json" ;;
  *) echo "fake gh: unknown endpoint $endpoint" >&2; exit 2 ;;
esac
if [[ -n "$jqexpr" ]]; then jq -c "$jqexpr" "$f"; else cat "$f"; fi
